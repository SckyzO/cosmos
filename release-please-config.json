{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-v-in-tag": false,
  "tag-separator": "@",
  "separate-pull-requests": false,
  "packages": {
    "packages/theme": { "component": "@sckyzo/cosmos-theme" },
    "packages/react": { "component": "@sckyzo/cosmos-react" },
    "packages/charts": { "component": "@sckyzo/cosmos-charts" }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "cosmos",
      "components": ["@sckyzo/cosmos-theme", "@sckyzo/cosmos-react", "@sckyzo/cosmos-charts"]
    }
  ]
}
