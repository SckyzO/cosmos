{
  "name": "@cosmos/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build": "storybook build -o storybook-static",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "a11y:todo": "vitest run --project=storybook --reporter=default --reporter=./.storybook/a11y-todo-reporter.ts",
    "a11y:contrast": "for theme in ${A11Y_THEME:-light sand deep-blue}; do echo \"Contrast pass: $theme\"; A11Y_THEME=$theme vitest run --project=storybook || exit 1; done"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@sckyzo/cosmos-charts": "workspace:*",
    "@sckyzo/cosmos-react": "workspace:*",
    "@sckyzo/cosmos-theme": "workspace:*",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
