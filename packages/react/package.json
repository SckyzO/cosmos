{
  "name": "@sckyzo/cosmos-react",
  "version": "0.5.0",
  "description": "React 19 + Tailwind 4 UI component library — 135+ themeable, accessible components (forms, overlays, navigation, tables, data display) with built-in light/dark mode.",
  "license": "MIT",
  "author": "SckyzO",
  "homepage": "https://github.com/SckyzO/cosmos/tree/main/packages/react",
  "bugs": "https://github.com/SckyzO/cosmos/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SckyzO/cosmos.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./code": {
      "import": {
        "types": "./dist/code/index.d.ts",
        "default": "./dist/code/index.js"
      },
      "require": {
        "types": "./dist/code/index.d.cts",
        "default": "./dist/code/index.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor/index.d.ts",
        "default": "./dist/editor/index.js"
      },
      "require": {
        "types": "./dist/editor/index.d.cts",
        "default": "./dist/editor/index.cjs"
      }
    },
    "./map": {
      "import": {
        "types": "./dist/map/index.d.ts",
        "default": "./dist/map/index.js"
      },
      "require": {
        "types": "./dist/map/index.d.cts",
        "default": "./dist/map/index.cjs"
      }
    },
    "./calendar.css": "./calendar.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "code": [
        "./dist/code/index.d.ts"
      ],
      "editor": [
        "./dist/editor/index.d.ts"
      ],
      "map": [
        "./dist/map/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/",
    "calendar.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo 'Stories and *.test.ts run via Vitest in @cosmos/storybook (apps/storybook).'",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "maplibre-gl": "^5.24.0 || ^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@sckyzo/cosmos-theme": "workspace:*",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.64.0",
    "react-day-picker": "^10.0.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "maplibre-gl": "6.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.5.0",
    "storybook": "^10.6.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "react-19",
    "tailwindcss",
    "tailwind-v4",
    "components",
    "cosmos"
  ]
}
