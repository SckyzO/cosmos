# cosmos-dev image
# Node 26 Debian (Playwright needs system libs Alpine doesn't bundle).
# Node 26 is the Current line and enters LTS on 2026-10-28.
# Embeds: pnpm 10, the system libraries Chromium needs, Storybook deps.
# Browsers are NOT baked in: `make install` fetches the revision each workspace
# Playwright pins into the bind-mounted workspace (PLAYWRIGHT_BROWSERS_PATH).
# Runs as non-root 'node' user, with UID/GID matching the host (build args).
#
# Build (preferred, via Makefile):
#   make build-image
#
# Manual:
#   docker build \
#     --build-arg USER_UID=$(id -u) \
#     --build-arg USER_GID=$(id -g) \
#     -t cosmos-dev:latest -f config/docker/Dockerfile.dev .

# Pinned by digest: the tag moves, and this image runs install scripts as root.
# Dependabot (docker ecosystem) bumps the tag and the digest together.
FROM node:26-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe

# --- Root: minimal utilities + corepack -------------------------------------
# DL3008 (pin apt versions) is intentionally ignored: on Debian bookworm-slim,
# point releases rotate package versions and drop the old ones from the mirrors,
# so pinning these base utilities would break `docker build` on the next refresh
# for no reproducibility gain worth that cost.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git make jq vim less procps \
 && rm -rf /var/lib/apt/lists/*

# Enable pnpm via corepack (version pinned in repo via package.json packageManager field).
# Node 25+ no longer bundles corepack, so install it from npm rather than pinning pnpm
# here — that keeps `packageManager` in package.json the single source of truth.
# corepack itself is pinned: it runs as root at build time.
RUN npm install -g corepack@0.36.0 \
 && corepack enable

# --- Root: install Playwright system deps (most accurate list comes from playwright itself)
# Same version as the workspace's playwright / @playwright/test (see the lockfile)
# and as the Playwright image CI's browser jobs run in (repo-policy.spec.ts).
RUN npx -y playwright@1.64.1 install-deps chromium \
 && rm -rf /var/lib/apt/lists/*

# --- Root: ImageMagick, for `make visual-diff` ------------------------------
# tests/e2e/captures/visual-diff.sh compares two captures with `compare` and
# `identify`. A layer of its own keeps the Playwright layer above in the cache.
# DL3008 is ignored for the reason given on the first apt-get above.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends imagemagick \
 && rm -rf /var/lib/apt/lists/*

# --- UID/GID matching host (default 1000:1000 if not passed) ----------------
ARG USER_UID=1000
ARG USER_GID=1000

# Adjust 'node' user (already exists in the node image with UID 1000) to match host.
RUN if [ "$USER_UID" != "1000" ] || [ "$USER_GID" != "1000" ]; then \
        groupmod -g "$USER_GID" node && usermod -u "$USER_UID" -g "$USER_GID" node; \
    fi

# --- Switch to non-root user ------------------------------------------------
# DL3066 wants a numeric UID so an orchestrator can verify runAsNonRoot. This is
# a local dev image, never scheduled by one, and 'node' is remapped above to the
# host UID — the name is what keeps HOME and the build args consistent.
# hadolint ignore=DL3066
USER node
WORKDIR /workspace

# --- Playwright browsers live in the workspace, not the image ---------------
# Browser revisions are tied to the exact Playwright version, and the workspace
# pins two (tests/e2e's @playwright/test, apps/storybook's playwright) that
# Dependabot bumps weekly. Baking `playwright@latest` here drifted from both, so
# e2e and Vitest couldn't launch. `make install` runs `pnpm browsers:install`,
# which fetches whatever the lockfile pins into this bind-mounted, gitignored
# path; a version bump then needs `make install`, not an image rebuild.
ENV PLAYWRIGHT_BROWSERS_PATH=/workspace/.cache/ms-playwright

# Tell pnpm to use a project-local store so it survives bind mounts.
ENV PNPM_HOME=/home/node/.pnpm-store
ENV PATH=$PNPM_HOME:$PATH

CMD ["bash"]
