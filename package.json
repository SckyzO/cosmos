{
  "name": "cosmos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system for sckyzo's projects (React 19 + Tailwind 4 + Storybook 10)",
  "license": "MIT",
  "author": "SckyzO",
  "homepage": "https://github.com/SckyzO/cosmos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SckyzO/cosmos.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "lint": "pnpm -r lint --max-warnings 0",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter '@cosmos/e2e' test",
    "browsers:install": "pnpm --filter '@cosmos/e2e' exec playwright install chromium && pnpm --filter '@cosmos/storybook' exec playwright install chromium",
    "build": "pnpm -r build",
    "storybook": "pnpm --filter '@cosmos/storybook' dev",
    "storybook:build": "pnpm --filter '@cosmos/storybook' build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "valibot@<1.4.2": "^1.4.2"
    }
  }
}
